# SG-Verify deployment settings. Copy to .env and edit.

# compose project name: prefix of all containers, networks and volumes of this stack
COMPOSE_PROJECT_NAME=sg_verify
# the UI is published on 127.0.0.1:<port> only
SG_VERIFY_PORT=8080

# images (built by install.sh, or loaded with docker load)
SG_VERIFY_UI_IMAGE=sg-verify/ui:v0.1
SG_VERIFY_SAM_IMAGE=sg-verify/sam-service:v0.1

# Team password for name-only sign-in. Used when the UI image is BUILT (it is baked into the bundle),
# so anyone who can open the page can sign in: use only on a closed network / via an ssh tunnel.
# install.sh generates a random one if empty. Leave it empty and set SG_VERIFY_NAME_ONLY=0 to get the usual
# username + password form.
SG_VERIFY_SHARED_PASSWORD=
SG_VERIFY_NAME_ONLY=1

# role of new users: admin (every reviewer can set verdicts in every task) or user
SG_VERIFY_DEFAULT_ROLE=admin

# restart policy of all containers: unless-stopped, always, no
SG_VERIFY_RESTART=unless-stopped

# SAM3 tracking service (docker compose --profile gpu): weights dir with sam3.pt, frame packages, GPU index,
# optional cap of GPU memory in GB (when the GPU is shared)
SG_VERIFY_MODELS_DIR=./models
SG_VERIFY_PACKAGES_DIR=./packages
SG_VERIFY_GPU=0
SG_GPU_MEMORY_GB=

# CVAT stops answering when the disk is fuller than this (percent)
CVAT_HEALTH_DISK_USAGE_MAX=90
